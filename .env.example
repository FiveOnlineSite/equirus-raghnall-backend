NODE_ENV=development
PORT=5000

# Comma-separated list; use exact origins without trailing slashes.
FRONTEND_ORIGINS=http://localhost:3000,https://equirus-raghnall.onrender.com

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/raghnall
JWT_SECRET=replace-with-at-least-32-random-characters

# For unrelated HTTPS frontend/backend domains use: none
# For localhost or related custom subdomains use: lax
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CDN_URL=https://your-cloudfront-domain.cloudfront.net

SMTP_EMAIL=
SMTP_APP_PASSWORD=
CONTACT_TO_EMAIL=

INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
